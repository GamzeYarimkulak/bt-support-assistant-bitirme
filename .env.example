# BT Support Assistant - local environment template
# Copy this file with: Copy-Item .env.example .env
# Never commit the generated .env file or a real API key.

# Application
APP_NAME=BT Support Assistant
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8010

# Response generation
# The application uses its retrieval-based fallback when this is false.
USE_REAL_LLM=false
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1500

# Embeddings and retrieval
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
MODELS_DIR=./models
BM25_K1=1.5
BM25_B=0.75
HYBRID_ALPHA=0.5
TOP_K_RETRIEVAL=10
KB_BOOST_ENABLED=true
KB_BOOST_FACTOR=1.15
FAISS_INDEX_PATH=./indexes/faiss_index.bin
VECTOR_DIM=384

# RAG
MAX_CONTEXT_LENGTH=2048
CONFIDENCE_THRESHOLD=0.7
TEMPERATURE=0.1

# Data and indexes
DATA_DIR=./data
INDEX_DIR=./indexes
ANONYMIZATION_ENABLED=true

# Chat logging
SAVE_CHAT_LOGS=true
CHAT_LOGS_DIR=./data/processed/chat_logs
SAVE_AS_TICKETS=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
